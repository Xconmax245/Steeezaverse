# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="your-project-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection (Pooled connection string in transaction mode, e.g. port 6543)
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Payment Gateways (NGN)
PAYSTACK_SECRET_KEY="your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="your-paystack-public-key"
FLUTTERWAVE_SECRET_KEY="your-flutterwave-secret-key"
FLUTTERWAVE_PUBLIC_KEY="your-flutterwave-public-key"

# Site URL used for payment callback redirects (set to production URL on Vercel)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Flat shipping cost applied at checkout (NGN). Set to "0" for free shipping.
SHIPPING_COST_NGN="0"

# Protects the keep-alive cron endpoint (scheduled via vercel.json)
CRON_SECRET="your-cron-secret"
